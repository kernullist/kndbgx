#include <windows.h>
#include "resource.h"

IDI_KNDX_APP ICON "kndbgx.ico"

IDR_KNDX_HTML RCDATA "..\\ui\\index.html"
IDR_KNDX_CSS  RCDATA "..\\ui\\app.css"
IDR_KNDX_JS   RCDATA "..\\ui\\app.js"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,10
 PRODUCTVERSION 0,2,0,10
 FILEFLAGSMASK 0x3fL
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "kernullist"
            VALUE "FileDescription", "KNDbgX WinDbg extension"
            VALUE "FileVersion", "0.2.0-preview.10"
            VALUE "InternalName", "kndbgx.dll"
            VALUE "LegalCopyright", "Copyright (c) kernullist"
            VALUE "OriginalFilename", "kndbgx.dll"
            VALUE "ProductName", "KNDbgX"
            VALUE "ProductVersion", "0.2.0-preview.10"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
